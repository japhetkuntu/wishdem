        }

        .nav span {
            font-size: 10px;
            color: var(--a);
            letter-spacing: .12em;
            font-weight: 800
        }

        .layout {
            display: grid;
            grid-template-columns: .78fr 1.22fr;
            gap: 30px;
            margin-top: 31px;
            align-items: start
        }

        .object {
            background: var(--m);
            padding: 20px;
            border-radius: var(--r);
            position: sticky;
            top: 16px
        }

        .object img {
            width: 100%;
            aspect-ratio: 1;
            display: block;
            border-radius: 14px;
            object-fit: cover
        }

        .object .days {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 14px
        }

        .days b {
            font: 500 35px 'Playfair Display';
            color: var(--a)
        }

        .days small {
            font-size: 10px;
            letter-spacing: .12em
        }

        .content .tag {
            font-size: 10px;
            color: var(--a);
            letter-spacing: .13em;
            font-weight: 800
        }

        .content h1 {
            font: 500 clamp(40px, 5vw, 62px)/1 'Playfair Display';
            margin: 10px 0 12px
        }

        .content>p {
            font-size: 14px;
            line-height: 1.6;
            max-width: 560px;
            margin: 0 0 18px;
            opacity: .72
        }

        .receipt {
            background: var(--s);
            color: var(--ink);
            border-radius: var(--r);
            padding: 20px
        }

        .receipt h2 {
            font: 500 25px 'Playfair Display';
            margin: 0 0 10px
        }

        .row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 11px 0;
            border-top: 1px solid #2A162922;
            font-size: 12px
        }

        .row b {
            text-align: right
        }

        .timeline {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin: 15px 0
        }

        .timeline div {
            background: #2A16290b;
            padding: 10px;
            border-radius: 8px;
            font-size: 10px;
            line-height: 1.45
        }

        .timeline b {
            display: block;
            color: var(--m);
            font-size: 11px
        }

        .btn {
            border: 0;
            background: var(--a);
            color: var(--p);
            border-radius: 999px;
            padding: 15px 18px;
            font-weight: 800;
            margin-top: 16px
        }

        @media(max-width:720px) {
            .shell {
                padding: 20px
            }

            .layout {
                grid-template-columns: 1fr;
                margin-top: 23px
            }

            .object {
                position: static;
                display: grid;
                grid-template-columns: 120px 1fr;
                gap: 14px;
                align-items: center;
                padding: 14px
            }

            .object img {
                grid-row: span 1
            }

            .object .days {
                display: block;
                margin: 0
            }

            .content h1 {
                font-size: 44px
            }

            .timeline {
                grid-template-columns: 1fr
            }

            .row {
                align-items: flex-start
            }

            .row b {
                max-width: 55%
            }
        }
    </style>
</head>

