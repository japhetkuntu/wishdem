    <style>
        :root {
            --p: #2A1629;
            --bg: #1B111D;
            --s: #F6F0E8;
            --a: #E6C87A;
            --m: #4A203D;
            --ink: #241D24;
            --r: 22px;
            --sh: 0 12px 32px rgba(13, 6, 14, .24)
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--s);
