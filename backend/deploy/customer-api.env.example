# Copy to /etc/wishdem/customer-api.env on the droplet (chmod 600, root-owned — this
# is systemd's EnvironmentFile, plain KEY=VALUE, no quotes, no `export`).
# Keys use ASP.NET Core's double-underscore convention for nested config
# (Cors:AllowedOrigins:0 -> Cors__AllowedOrigins__0), same as appsettings.json.

# --- Database / cache (Postgres/Redis installed natively — see install.sh) ---
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=WishDem;Username=wishdem;Password=REPLACE_WITH_THE_PASSWORD_YOU_SET_IN_INSTALL_SH
ConnectionStrings__Redis=localhost:6379

# --- JWT signing key ---------------------------------------------------------
# Generate with: openssl rand -base64 48
# Must differ from ADMIN_JWT_SIGNING_KEY and must not start with "dev-only-signing-key"
# — the app refuses to boot in Production otherwise.
Jwt__SigningKey=

# --- CORS (must be the exact origin your customer-portal frontend is served from) ---
Cors__AllowedOrigins__0=https://wishdem.com
# Optional second origin (e.g. a www. variant) — delete this line if not needed.
Cors__AllowedOrigins__1=

# --- Google Sign-In (optional) ------------------------------------------------
GoogleAuth__ClientId=

# --- Email via Mailtrap Send API (OTP codes, wish delivery emails) -----------
# Sending API token from your Mailtrap account (Sending Domains -> API Tokens),
# not an SMTP username/password.
Mailtrap__ApiToken=
Mailtrap__FromEmail=no-reply@wishdem.com
Mailtrap__FromName=WishDem
# Leave Sandbox=false for real delivery. Set to true (+ SandboxInboxId) to route
# through Mailtrap's testing inbox instead of real recipients.
Mailtrap__Sandbox=false
Mailtrap__SandboxInboxId=

# --- SMS (wish delivery via Arkesel) ------------------------------------------
Sms__Arkesel__ApiKey=
Sms__Arkesel__SenderId=WishDem

# --- Used to build the recipient's private wish link in delivery emails/SMS ---
DeliveryWorker__FrontendBaseUrl=https://wishdem.com

# --- DigitalOcean Spaces (wish attachments) -----------------------------------
# BucketName can be a bucket shared with other projects — RootFolder keeps this
# project's objects under their own top-level folder (e.g. "wishdem/wishes/...")
# so nothing collides with whatever else lives in the same bucket. Leave
# RootFolder blank if this bucket is dedicated to WishDem only.
Storage__AccessKey=
Storage__SecretKey=
Storage__BucketName=wishdem-media
Storage__Region=fra1
Storage__Endpoint=https://fra1.digitaloceanspaces.com
# CDN endpoint is optional — only set if you've enabled the Spaces CDN.
Storage__CdnEndpoint=
Storage__ForcePathStyle=false
Storage__RootFolder=wishdem
