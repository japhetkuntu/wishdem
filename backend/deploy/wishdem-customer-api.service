[Unit]
Description=WishDem Customer API
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=wishdem
Group=wishdem
WorkingDirectory=/var/www/wishdem/customer-api
ExecStart=/usr/bin/dotnet /var/www/wishdem/customer-api/WishDem.Customer.Api.dll
Restart=on-failure
RestartSec=5

Environment=ASPNETCORE_ENVIRONMENT=Production
# Loopback-only — Nginx is the only thing that talks to this port, never the internet.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
# wishdem is a homeless system user (and ProtectHome=true blocks /home anyway), so the
# dotnet host's one-time "first run" setup — which tries to write to ~/.dotnet — must be
# suppressed, or every start crashes with UnauthorizedAccessException before the app even
# loads. DOTNET_CLI_HOME redirects anything that slips through to a path this unit can write.
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
Environment=DOTNET_CLI_HOME=/var/www/wishdem/customer-api/logs
EnvironmentFile=/etc/wishdem/customer-api.env

# Sandboxing: this service can't write anywhere except its own logs directory,
# can't gain new privileges, and gets a private /tmp.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/www/wishdem/customer-api/logs

[Install]
WantedBy=multi-user.target
