[Unit]
Description=WishDem Customer API
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/wishdem/customer-api
ExecStart=/usr/bin/dotnet /var/www/wishdem/customer-api/WishDem.Customer.Api.dll
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStartSec=300
SyslogIdentifier=wishdem-customer-api
StandardOutput=journal
StandardError=journal

Environment=ASPNETCORE_ENVIRONMENT=Production
# Loopback-only — Nginx is the only thing that talks to this port, never the internet.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
# www-data already has a real home directory, so dotnet's one-time "first run" setup
# (which otherwise tries to write to ~/.dotnet) isn't a problem here the way it was
# under a homeless custom system user — these are kept anyway as cheap insurance.
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
EnvironmentFile=/etc/wishdem/customer-api.env

[Install]
WantedBy=multi-user.target
