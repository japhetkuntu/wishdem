# Copy to /etc/wishdem/admin-api.env on the droplet (chmod 600, root-owned — this is
# systemd's EnvironmentFile, plain KEY=VALUE, no quotes, no `export`).

# --- Database / cache (Postgres/Redis installed natively — see install.sh) ---
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=WishDem;Username=wishdem;Password=REPLACE_WITH_THE_PASSWORD_YOU_SET_IN_INSTALL_SH
ConnectionStrings__Redis=localhost:6379

# --- JWT signing key ---------------------------------------------------------
# Generate with: openssl rand -base64 48
# Must differ from CUSTOMER_JWT_SIGNING_KEY and must not start with "dev-only-signing-key"
# — the app refuses to boot in Production otherwise.
Jwt__SigningKey=

# --- CORS (must be the exact origin your admin-portal frontend is served from) ---
Cors__AllowedOrigins__0=https://admin.wishdem.com

# --- Bootstrap admin account ---------------------------------------------------
# Password must differ from the default "ChangeMe123!" — the app refuses to boot
# in Production otherwise. Seeded once; change it from the admin UI afterwards.
SuperAdmin__Email=you@wishdem.com
SuperAdmin__Password=
SuperAdmin__FullName=WishDem Admin

# --- Email via Mailtrap Send API (password reset codes) -----------------------
# Sending API token from your Mailtrap account (Sending Domains -> API Tokens),
# not an SMTP username/password.
Mailtrap__ApiToken=
Mailtrap__FromEmail=no-reply@wishdem.com
Mailtrap__FromName=WishDem
Mailtrap__Sandbox=false
Mailtrap__SandboxInboxId=
